PORT=3001

# Base de données (utilisateur applicatif en lecture seule, cf. database/create_api_user.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trouve_ton_artisan
DB_USER=ttarisan_api
DB_PASSWORD=

# Clé partagée entre le frontend et l'API (limite l'accès à l'application)
API_KEY=changez-moi-avec-une-valeur-longue-et-aleatoire

# Origine autorisée pour le CORS (URL du frontend)
FRONTEND_ORIGIN=http://localhost:5173

# Envoi d'email (SMTP) - Mailtrap Sandbox en développement (aucun email réel envoyé)
# Créez un compte gratuit sur https://mailtrap.io, puis récupérez les identifiants
# du "Sandbox" (Email Testing > votre inbox > Show credentials > SMTP).
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@trouve-ton-artisan.fr
